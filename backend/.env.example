DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_REGISTRATION_DOMAINS=iic.edu.np
CSRF_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-web-client-id.apps.googleusercontent.com
HELPDESK_URL=https://ithelpdesk-iic.cloud-dev.tech

# ── Email verification ────────────────────────────────────────────────────────
# Standard Django email settings used to send verification emails.
# In development, use django.core.mail.backends.console.EmailBackend to see
# emails in the console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@iic.edu.np
EMAIL_HOST_PASSWORD=replace-with-app-password

# Sender address shown in verification emails
VERIFICATION_FROM_EMAIL=noreply@iic.edu.np

# How many hours a verification link is valid (default: 24)
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Set to False in development/CI to skip sending actual emails.
# New users will still be created as inactive; you must call
# /api/v1/auth/verify-email/ with a valid token to activate them.
EMAIL_VERIFICATION_ENABLED=true

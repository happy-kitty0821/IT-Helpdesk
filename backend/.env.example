DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_REGISTRATION_DOMAINS=iic.edu.np
CSRF_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-web-client-id.apps.googleusercontent.com
HELPDESK_URL=https://ithelpdesk-iic.cloud-dev.tech

# ── Email transport (Django 6.1 MAILERS format) ───────────────────────────────
#
# IMPORTANT: Do NOT use the legacy EMAIL_BACKEND / EMAIL_HOST / EMAIL_PORT /
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD / EMAIL_USE_TLS variable names.
# Django 6.1 raises ImproperlyConfigured if any EMAIL_* setting coexists
# with the MAILERS dict.  Use the MAILER_* names below instead.
#
# Development (console — emails printed to terminal, nothing actually sent):
MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
MAILER_HOST=localhost
MAILER_PORT=587
MAILER_USE_TLS=true
MAILER_USE_SSL=false
MAILER_USERNAME=
MAILER_PASSWORD=

# Production (SMTP — fill in real values on the server):
# MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_USE_TLS=true
# MAILER_USERNAME=noreply@iic.edu.np
# MAILER_PASSWORD=replace-with-app-password   ← set only in server environment, never commit

# ── Email verification settings ───────────────────────────────────────────────

# The "From:" address shown in verification emails
VERIFICATION_FROM_EMAIL=noreply@iic.edu.np

# How many hours a verification link is valid (default: 24)
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Set to false in CI/local dev to skip sending real emails.
# New users will still be created as inactive and a token will still be
# created in the DB — you can verify manually via /api/v1/auth/verify-email/.
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24

# ── File uploads (Cloudflare Tunnel + chunked upload) ─────────────────────────
#
# Use X-Accel-Redirect (Nginx internal redirect) for gated software downloads
# in production.  Django sends only the header; Nginx serves the bytes.
# Set to false in local development.
MEDIA_ACCEL_REDIRECT=false

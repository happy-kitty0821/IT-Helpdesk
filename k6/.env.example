# Base URL of the Django backend (no trailing slash)
BASE_URL=http://127.0.0.1:8000

# Student / requester account (must be a verified, active account)
STUDENT_EMAIL=student@iic.edu.np
STUDENT_PASSWORD=YourStudentPassword123!

# Staff account — any of: administrator, service_lead, it_agent
STAFF_EMAIL=staff@iic.edu.np
STAFF_PASSWORD=YourStaffPassword123!

# Administrator account (needed for admin-only endpoints)
ADMIN_EMAIL=admin@iic.edu.np
ADMIN_PASSWORD=YourAdminPassword123!

# A valid service category slug to submit tickets against
TEST_CATEGORY_SLUG=general-support
